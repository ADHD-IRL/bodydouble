{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "first_action": {
      "type": "string"
    },
    "done_condition": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "inbox",
        "today",
        "focus",
        "parked",
        "paused",
        "completed",
        "good_enough_done",
        "delegated",
        "abandoned"
      ],
      "default": "inbox"
    },
    "energy_required": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "context": {
      "type": "string",
      "enum": [
        "home",
        "work",
        "computer",
        "phone",
        "outside",
        "errands",
        "social",
        "other"
      ],
      "default": "other"
    },
    "emotional_load": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "time_estimate_minutes": {
      "type": "number",
      "description": "Estimated time to complete the task in minutes"
    },
    "ocd_risk_flag": {
      "type": "boolean",
      "default": false
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "last_opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reopen_count": {
      "type": "number",
      "default": 0
    },
    "edit_count": {
      "type": "number",
      "default": 0
    },
    "reassurance_request_count": {
      "type": "number",
      "default": 0
    },
    "future_you_note": {
      "type": "string"
    },
    "current_certainty_budget_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}