{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "work",
        "home",
        "admin",
        "study",
        "health",
        "errands",
        "creative",
        "other"
      ],
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "started",
        "in_progress",
        "partly_done",
        "done",
        "carried_forward"
      ],
      "default": "not_started"
    },
    "energy_required": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "The date this task is scheduled for (YYYY-MM-DD)"
    },
    "scheduled_time": {
      "type": "string",
      "description": "The time this task is scheduled for (HH:MM)"
    },
    "time_estimate_minutes": {
      "type": "number",
      "description": "Estimated time to complete in minutes"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "tiny_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Shrunk micro-steps for this task"
    },
    "current_tiny_action_index": {
      "type": "number",
      "default": 0
    },
    "progress_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "current_focus_session_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}