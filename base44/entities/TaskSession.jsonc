{
  "name": "TaskSession",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "timer_length_minutes": {
      "type": "number",
      "default": 2
    },
    "user_reported_difficulty": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "user_reported_urge": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "parked_thoughts_count": {
      "type": "number",
      "default": 0
    },
    "completion_state": {
      "type": "string",
      "enum": [
        "completed",
        "good_enough_done",
        "paused",
        "abandoned"
      ]
    },
    "future_you_note": {
      "type": "string"
    },
    "wearable_activation_flag": {
      "type": "boolean",
      "default": false
    },
    "mood_after": {
      "type": "string",
      "enum": [
        "drained",
        "neutral",
        "okay",
        "good",
        "energized"
      ],
      "description": "How the user felt after completing the task"
    }
  },
  "required": []
}